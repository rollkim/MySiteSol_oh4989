# oh4989 환경변수 템플릿 — 값은 비워 둔다. 실제 값은 .env.local / 서버의 shared/oh4989.env 에만 둔다.
# (CLAUDE.md RULE-1: .env 계열 파일은 열지 않는다)

# ── DB (PostgreSQL 17) ────────────────────────────────────────
# 개발: SSH 터널 경유. 예) postgresql://oh4989_app@127.0.0.1:15432/oh4989
#   ssh -L 15432:127.0.0.1:5432 oh4989@1.234.79.54
# 운영: 127.0.0.1:5432 직접. 5432 포트를 외부에 열지 않는다.
DATABASE_URL=

# ── 관리자 세션 ───────────────────────────────────────────────
SESSION_SECRET=

# ── 카카오 (developers.kakao.com) ─────────────────────────────
# ⚠️ 2026.7.21부터 계정당 첫 앱만 무료 — 기존 활성 앱이 있으면 과금 확인
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_REST_KEY=

# ── 통계 ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
GA_SERVICE_ACCOUNT_JSON=

# ── 사이트 ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://oh4989.com
# 업로드는 릴리스 폴더 밖 고정 경로에 쌓는다 (재배포로 사라지지 않게)
UPLOAD_DIR=/home/oh4989/shared/uploads

# ── 검색엔진 소유확인 ─────────────────────────────────────────
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
