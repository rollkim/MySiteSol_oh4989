# oh4989 환경변수 템플릿 — 값은 비워 둔다. 실제 값은 .env.local / 서버의 shared/oh4989.env 에만 둔다.
# (CLAUDE.md RULE-1: .env 계열 파일은 열지 않는다)

# ── DB (PostgreSQL 17) ────────────────────────────────────────
# 개발: SSH 터널 경유. 예) postgresql://oh4989_app@127.0.0.1:15432/oh4989
#   ssh -L 15432:127.0.0.1:5432 oh4989@1.234.79.54
# 운영: 127.0.0.1:5432 직접. 5432 포트를 외부에 열지 않는다.
DATABASE_URL=

# ── 관리자 세션 ───────────────────────────────────────────────
SESSION_SECRET=

# ── 배치(연락처 자동 파기) ────────────────────────────────────
# 개인정보처리방침에 공표한 "접수일로부터 3개월 후 연락처 자동 파기"의 실행 키.
# 미설정이면 /api/cron/purge-contacts가 503으로 거부한다(열린 파기 경로 방지).
# 서버 crontab 예: 0 4 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/purge-contacts
CRON_SECRET=

# ── 네이버 지도 (NCP Maps — SPEC 수정 이력 #5로 카카오맵에서 전환) ──
# ncloud.com 콘솔 → Maps → Application 등록 (Web 서비스 URL에 도메인·localhost 등록)
# Client ID는 JS SDK 스크립트 URL에 실려 공개됨(NEXT_PUBLIC), Secret은 서버 Geocoding 전용
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ── 통계 ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
GA_SERVICE_ACCOUNT_JSON=

# ── 사이트 ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://oh4989.com
# 업로드는 릴리스 폴더 밖 고정 경로에 쌓는다 (재배포로 사라지지 않게)
UPLOAD_DIR=/home/oh4989/shared/uploads

# ── 검색엔진 소유확인 ─────────────────────────────────────────
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
